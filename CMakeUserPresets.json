{
  "version": 3,
  "configurePresets": [
    {
      "name": "non-gui",
      "displayName": "Developer mode, gui disabled, with all features/dependencies disabled",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_BENCH": "OFF",
        "BUILD_CLI": "ON",
        "BUILD_DAEMON": "ON",
        "BUILD_FUZZ_BINARY": "OFF",
        "BUILD_GUI": "OFF",
        "BUILD_GUI_TESTS": "OFF",
        "BUILD_KERNEL_LIB": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_TX": "OFF",
        "BUILD_UTIL": "ON",
        "BUILD_UTIL_CHAINSTATE": "OFF",
        "BUILD_WALLET_TOOL": "ON",
        "ENABLE_EXTERNAL_SIGNER": "OFF",
        "ENABLE_HARDENING": "OFF",
        "ENABLE_WALLET": "ON",
        "WARN_INCOMPATIBLE_BDB": "OFF",
        "WITH_BDB": "OFF",
        "WITH_MULTIPROCESS": "OFF",
        "WITH_QRENCODE": "OFF",
        "WITH_SQLITE": "ON",
        "WITH_USDT": "OFF",
        "WITH_ZMQ": "OFF"
      }
    }
  ]
}
